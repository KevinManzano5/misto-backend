PORT=:2003
APP_NAME=misto-backend
MAIN_PATH=./cmd/api
MIGRATE_PATH=./migrations
DB_URL=postgresql://postgres:password@localhost:5432/misto?sslmode=disable
JWT_SECRET=abcd1234
# How long an access token (JWT) is valid for. Go duration string (e.g. "15m", "1h").
# Defaults to 15m when unset.
ACCESS_TOKEN_DURATION="15m"
# How long a refresh token is valid for before it must be used to get a new token pair.
# Go duration string (e.g. "168h" for 7 days). Defaults to 168h (7 days) when unset.
REFRESH_TOKEN_DURATION="168h"
# How often the background job sweeps for pending/confirmed appointments whose end_time has
# already passed and moves them to a terminal status (completed/expired). Go duration string
# (e.g. "5m", "30s"). Defaults to 5m when unset.
APPOINTMENT_EXPIRY_INTERVAL="2m"
